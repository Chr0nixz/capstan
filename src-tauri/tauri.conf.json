{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capstan",
  "version": "0.1.0",
  "identifier": "dev.capstan.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm -C ui dev",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Build-Frontend.ps1"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Capstan",
        "width": 1280,
        "height": 800,
        "minWidth": 330,
        "minHeight": 240,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../target/runtime/": "runtime/",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../docs/PORTABLE.md": "PORTABLE-README.md"
    },
    "icon": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
